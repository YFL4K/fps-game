{
  "name": "@YFL4K/procedural-fps",
  "version": "10.4.0",
  "description": "纯前端程序化生成的第一人称射击游戏：6 种武器、爆头、5 关任务 + 无尽模式、90x90 大地图（墙体掩体/可破坏场景）。零依赖，双击 index.html 即玩。",
  "main": "index.html",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "files": [
    "index.html",
    "three.min.js",
    "scene-layout.js",
    "scene-layout-level2.js",
    "models",
    "DESIGN.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "npx --yes http-server -p 8000 -c-1",
    "serve": "python3 -m http.server 8000"
  },
  "keywords": [
    "fps",
    "threejs",
    "game",
    "procedural",
    "webgl",
    "first-person-shooter"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=14"
  }
}
